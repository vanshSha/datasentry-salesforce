<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Rule_Severity_Required</fullName>
    <active>true</active>
    <errorConditionFormula
  >AND(Active__c, ISBLANK(TEXT(Severity__c)))</errorConditionFormula>
    <errorDisplayField>Severity__c</errorDisplayField>
    <errorMessage
  >Select a severity before activating this data-quality rule.</errorMessage>
</ValidationRule>
