<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Rule_Condition_Required</fullName>
    <active>true</active>
    <errorConditionFormula
  >AND(Active__c, ISBLANK(Rule_Condition__c))</errorConditionFormula>
    <errorDisplayField>Rule_Condition__c</errorDisplayField>
    <errorMessage
  >Enter a rule condition before activating this data-quality rule.</errorMessage>
</ValidationRule>
